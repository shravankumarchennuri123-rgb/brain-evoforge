# REQUIRED
WQ_BRAIN_EMAIL=
WQ_BRAIN_PASSWORD=

# Write safety: dry-run is default. Set to true only after live discovery works.
WQ_WRITE_ARMED=false

# One-alpha live test has its own independent write switch.
WQ_ONE_ALPHA_WRITE_ARMED=false

# Target is 4 newly verified regular + 1 newly verified SuperAlpha.
WQ_TARGET_REGULAR=4
WQ_TARGET_SUPER=1

# Account-specific execution profile. Leave blank to discover from recent alphas.
WQ_REGION=
WQ_UNIVERSE=
WQ_DELAY=
WQ_INSTRUMENT_TYPE=EQUITY

# Optional: preferred LLM through an OpenAI-compatible API.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Research and operational limits.
WQ_MAX_CANDIDATES_PER_CYCLE=24
WQ_MAX_CONCURRENT_SIMS=2
WQ_MAX_POLL_SECONDS=900
WQ_IDLE_SECONDS=30
WQ_DAY_TIMEZONE=America/New_York
WQ_DB_PATH=data/evoforge.sqlite3
WQ_LOG_PATH=logs/evoforge.log

# Fail-closed controls.
WQ_ALLOW_UNKNOWN_SUBMISSION_BUDGET=false
WQ_ALLOW_BROWSER_AUTH=false
